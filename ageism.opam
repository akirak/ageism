opam-version: "2.0"
depends: [
  "dune" {>= "3.23"}
  "ocaml" {>= "5.2"}
  "cmdliner"
  "digestif"
  "eio"
  "fmt"
  "eio_main"
  "yojson"
  "ppx_yojson_conv"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
